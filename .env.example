# ==================================================
# PANASEA — Environment Configuration
# ==================================================
# Copy this file to ".env" and fill in real values.
# Never commit ".env" — it is already listed in .gitignore.

# --------------------------------------------------
# Database
# --------------------------------------------------
# BATCH 1 uses SQLite so the project runs immediately with zero external
# services. To move to PostgreSQL for staging/production later, change the
# `provider` in prisma/schema.prisma to "postgresql" and set this to a
# postgres connection string (e.g. postgresql://user:pass@host:5432/db).
DATABASE_URL="file:./dev.db"

# --------------------------------------------------
# Application
# --------------------------------------------------
# Base URL of the app, used for building absolute links (e.g. receipts, webhooks).
APP_URL="http://localhost:3000"

# Secret used to sign/verify session tokens (see src/lib/auth/jwt.ts).
# REQUIRED — the app will not start login without this set.
# Generate a long random value, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# --------------------------------------------------
# QRIS / Payment Provider (placeholder — configured in a later batch)
# --------------------------------------------------
# The payment layer is built as a provider-agnostic abstraction (see
# src/lib/payments). Nothing about a specific QRIS provider is hardcoded.
# When a provider is chosen, its credentials will be added here, e.g.:
# QRIS_PROVIDER="xendit"
# QRIS_API_KEY=""
# QRIS_WEBHOOK_SECRET=""
